# App
APP_NAME=DocuQuery
APP_VERSION=0.1.0
DEBUG=false

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com

# Rate limiting
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_CHAT=30/minute

# Database
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=docuquery
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=docuquery

# Integration tests only. When set, tests marked `integration` run Alembic against
# this database and exercise real SQL; when unset they skip. Must point at a server
# with the pgvector extension available, and must NOT be a database you care about —
# the fixtures TRUNCATE it between tests.
#   docker run -d -p 5433:5432 -e POSTGRES_PASSWORD=postgres \
#       -e POSTGRES_DB=docuquery_test pgvector/pgvector:pg16
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/docuquery_test

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# Ingestion
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Authentication
# REQUIRED whenever DEBUG=false - the app refuses to start without it.
# This value alone signs every session cookie; anyone who knows it can forge a
# session for any user. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=<generate-a-strong-random-value>
AUTH_COOKIE_NAME=docuquery_session
AUTH_SESSION_DAYS=30
# Cookies are Secure + SameSite=None by default, for a cross-site Vercel -> Railway
# setup. Set to false only for local http development.
AUTH_COOKIE_SECURE=true

# LLM
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_MAX_CONTEXT_TOKENS=3000
LLM_STREAMING_ENABLED=true
LLM_TIMEOUT=30.0
LLM_API_KEY=<your-groq-api-key>
OLLAMA_BASE_URL=http://localhost:11434

# Live web search (Hybrid mode only)
# Get a key from https://app.tavily.com/
TAVILY_API_KEY=<your-tavily-api-key>
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
